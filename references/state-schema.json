{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle state v1 (read compatibility) and v2 (managed execution)",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "work_item",
    "inputs",
    "decisions",
    "open_decisions",
    "tasks"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "work_item": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "path",
          "sha256",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "const": "approved"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ]
      }
    },
    "open_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "planned",
              "ready",
              "running",
              "verifying",
              "blocked",
              "awaiting-decision",
              "done",
              "cancelled"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "input_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "context": {
      "type": "object"
    },
    "artifacts": {
      "type": "array"
    },
    "reviews": {
      "type": "array"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "context",
          "artifacts",
          "reviews"
        ]
      }
    }
  ]
}
